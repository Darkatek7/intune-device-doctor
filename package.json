{
  "name": "mdm-doctor",
  "private": true,
  "version": "0.1.0",
  "description": "One-Click Intune Device Troubleshooter – read-only Dashboard für IT-Admins (Demo + Live über Microsoft Graph, Analyse von Intune-DiagLogs-ZIPs).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixture": "tsx scripts/make-fixture-zip.ts",
    "check": "npm run lint && npm run typecheck && npm test && vite build"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.25.1",
    "@azure/msal-react": "^5.7.2",
    "@zip.js/zip.js": "^2.23.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
