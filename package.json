{
  "name": "mdm-doctor",
  "private": true,
  "version": "0.1.0",
  "description": "One-Click Intune Device Troubleshooter – read-only Dashboard für IT-Admins (Demo + Live über Microsoft Graph, Analyse von Intune-DiagLogs-ZIPs).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixture": "tsx scripts/make-fixture-zip.ts",
    "check": "npm run lint && npm run typecheck && npm test && vite build",
    "test:e2e": "playwright test",
    "check:full": "npm run check && npm run test:e2e",
    "capture:launch": "tsx e2e/capture-launch-assets.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.28.0",
    "@azure/msal-react": "^5.8.0",
    "@zip.js/zip.js": "^2.24.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
