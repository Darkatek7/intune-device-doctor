# Kopieren nach .env.local und anpassen. .env.local wird nicht committet.

# demo = realistische Mock-Daten (Standard), live = Microsoft Graph
VITE_APP_MODE=demo

# Nur für den Live-Modus: Entra-App-Registrierung (Plattform "Single-page application")
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=
# Optional, Standard ist window.location.origin
VITE_MSAL_REDIRECT_URI=
